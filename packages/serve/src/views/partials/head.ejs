<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= serverName || 'Merapihost' %> - Domain Verification Failed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Figtree', sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: stretch;
            align-items: stretch;
        }

        .container {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .logo {
            margin-top: -50px;
        }
        .logo .error-icon {
            position: absolute;
            bottom: 0px;
            left: -25px;
        }

        h1 {
            color: #1a1a1a;
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .subtitle {
            color: #888;
            font-size: 17px;
            font-weight: 400;
            margin-bottom: 30px;
        }

        .message {
            margin: 30px 0;
            color: #444;
            font-size: 15px;
            line-height: 1.6;
        }

        .error-details {
            background: #f8f9fa;
            padding: 16px 20px;
            border-radius: 8px;
            margin: 16px 0;
            text-align: left;
        }

        .error-details ul {
            padding-left: 20px;
        }

        .error-details ul li {
            list-style: none;
        }

        .help-box {
            background: #fefce8;
            padding: 16px 20px;
            border-radius: 8px;
            margin: 16px 0;
            border-left: 3px solid #f59e0b;
        }

        .help-box a:hover {
            text-decoration: underline !important;
        }

        .actions {
            margin: 30px 0;
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            color: #bbb;
            font-size: 13px;
            text-align: center;
        }

        .info-container {
            display: flex;
            flex-direction: row;
            gap: 12px;
            margin-top: 20px;
        }
        .info-container li {
            list-style: none;
            background: #f8f9fa;
            padding: 12px 16px;
            border-radius: 8px;
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 100px;
        }
        .text-center {
            text-align: center;
        }

        @media (max-width: 480px) {
            .container {
                padding: 30px 20px;
            }
            h1 {
                font-size: 24px;
            }
            .subtitle {
                font-size: 15px;
            }
            .actions {
                flex-direction: column;
                align-items: center;
            }
            .error-details ul {
                padding-left: 12px;
            }
        }
    </style>
</head>