<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><% title %></title>
    <% meta.forEach(meta => { %>
        <meta name="<%= meta.name %>" content="<%= meta.content %>">
    <% }) %>
    
    <%- styles %>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        * {
            box-sizing: border-box;
        }
    </style>
</head>
<body>
    <%- body %>
</body>
</html>