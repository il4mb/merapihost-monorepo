<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { 
    title: "Internal Server Error",
    description: "An unexpected error occurred on the server.",
    keywords: "error, server, internal server error, 500",
}) %>

<body>
    <div class="container">
        <div class="logo">
            <%- include('partials/logo', { full: true, width: 280, height: 75, fill: '#ef1111' }) %>
        </div>
        
        <h1><%= error.status || 500 %></h1>
        <p class="subtitle">Something went wrong</p>

        <div class="message">
            <p>We're experiencing technical difficulties.</p>
            <p style="font-size:14px; color:#888; margin-top:8px;">
                Please try again later or contact support if the problem persists.
            </p>
        </div>

        <%- include('partials/footer') %>
    </div>
</body>

</html>